# Circle: the agent's wallet. the key is never in this process.
# The SDK is hardcoded to https://api.circle.com, so this must be a TEST_API_KEY.
# A SAND_API_KEY only works against api-sandbox.circle.com, which is a different
# host and a different product.
CIRCLE_API_KEY=

# 64 lowercase alphanumeric characters. Circle derives the signing key from this;
# it is never transmitted in the clear and never exists in application memory.
CIRCLE_ENTITY_SECRET=

# The agent's developer-controlled wallet, created once with scripts/bootstrap.
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=

# A WRITABLE Arc node. Arc's public RPCs reject eth_sendTransaction, so reading
# works anywhere and writing does not.
#   qn endpoint create --chain arc --network arc-testnet
# For local work, point this at anvil: http://127.0.0.1:8545
HOROS_RPC_URL=

# Deploys the contracts, and signs the payer's half of a succession ceremony.
# The agent itself never uses this: it signs through Circle.
HOROS_DEPLOYER_PRIVATE_KEY=

# Who owns the CustodyVault. Ownership means the ability to set spending limits
# and to stop the vault. It never means the ability to redirect a payment, because
# pay() takes no address. Set this to CIRCLE_WALLET_ADDRESS for the keyless demo.
HOROS_VAULT_OWNER=

# Throwaway testnet identities, used only by scripts/demo* so the ceremony has a
# vendor who can sign for itself and an attacker who cannot. They hold testnet
# dust and must never hold anything else. Generate with:
#   node -e "console.log(require('viem/accounts').generatePrivateKey())"
HOROS_DEMO_VENDOR_KEY=
HOROS_DEMO_VENDOR_NEW_KEY=
HOROS_DEMO_ATTACKER_KEY=

# Optional. Used only to read an invoice into fields and to propose a verdict.
# The system is built to work without it: extraction falls back to regex, and the
# policy never reads a model output when deciding whether to release funds.
ANTHROPIC_API_KEY=

# Judgment layer. Returns calibrated probabilities rather than text, so a model
# can raise a question but never authorise a payment. Optional: without it the
# policy still decides, and only from onchain history.
#   https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
