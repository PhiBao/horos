{
  "name": "horos",
  "version": "0.1.0",
  "private": true,
  "description": "A change of payment address is a succession ceremony, not a field update.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:build": "cd contracts && forge build",
    "contract:test": "cd contracts && forge test -vv",
    "deploy:testnet": "tsx scripts/deploy.ts",
    "deploy:mainnet": "HOROS_NETWORK=arc-mainnet tsx scripts/deploy.ts",
    "demo": "tsx scripts/demo.ts",
    "verify": "tsx scripts/verify.ts",
    "recover": "tsx scripts/recover.ts",
    "sweep": "tsx scripts/sweep.ts",
    "check:circle": "tsx scripts/check-circle.ts",
    "check:chain": "tsx scripts/check-chain.ts",
    "check:pages": "tsx scripts/check-pages.ts",
    "check:ui": "tsx scripts/check-ui.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:pages && pnpm contract:test",
    "wallet:bootstrap": "tsx scripts/bootstrap-wallet.ts",
    "site:dev": "wrangler dev --port 8787 --ip 127.0.0.1",
    "site:deploy": "wrangler deploy --env-file worker/empty.env",
    "site:types": "wrangler types --env-file worker/empty.env --strict-vars false",
    "site:secret": "wrangler secret put JUDGMENT_API_KEY",
    "sync:site": "tsx scripts/sync-worker-config.ts",
    "faucet": "tsx scripts/faucet.ts",
    "demo:circle": "tsx scripts/demo-circle.ts",
    "abi:read": "tsx scripts/gen-read-abi.ts",
    "capture": "tsx scripts/capture.ts"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^4.6.0",
    "@circle-fin/smart-contract-platform": "^4.3.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.144.0"
  },
  "author": "PhiBao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhiBao/horos.git"
  },
  "homepage": "https://github.com/PhiBao/horos#readme",
  "bugs": {
    "url": "https://github.com/PhiBao/horos/issues"
  }
}
