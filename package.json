{
  "name": "horos",
  "version": "0.1.0",
  "private": true,
  "description": "A change of payment address is a succession ceremony, not a field update.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "dev": "next dev -p 3939",
    "build": "next build",
    "start": "next start -p 3939",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:build": "cd contracts && forge build",
    "contract:test": "cd contracts && forge test -vv",
    "deploy:testnet": "tsx scripts/deploy.ts",
    "wallet:bootstrap": "tsx scripts/bootstrap-wallet.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^4.6.0",
    "@circle-fin/smart-contract-platform": "^4.3.0",
    "@circle-fin/app-kit": "latest",
    "@tanstack/react-query": "^5.62.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
